{
  "_meta": {
    "purpose": "Series data for the {% chart %} shortcode. Every entry's `metric` must be a published id in metrics.json — the shortcode throws at build if it is missing or unpublished, so a chart cannot outrun the data layer.",
    "types": ["before-after", "decay", "comparison"]
  },

  "items": {
    "e2e_latency_decay": {
      "type": "decay",
      "metric": "e2e_latency_2026",
      "title": "End-to-end pipeline latency, January–June 2026",
      "unit": "seconds (median)",
      "series": [
        { "label": "Jan 2026", "value": 27 },
        { "label": "Feb 2026", "value": 15 },
        { "label": "Apr 2026", "value": 5.5 },
        { "label": "May 2026", "value": 28.3, "note": "staging regression, never reached production" },
        { "label": "15 Jun 2026", "value": 3.2 }
      ],
      "basis": "vault://metrics.md#MET-005, MET-055, MET-056"
    },

    "golden_dataset_growth": {
      "type": "before-after",
      "metric": "golden_dataset_growth",
      "title": "India Maternal Health golden-dataset size",
