---
layout: layouts/page.njk
permalink: /skills/
title: Capabilities
shortTitle: Capabilities
description: A capability matrix with three honest levels rather than percentage bars, where every Core claim links to the case study that proves it.
lede: Three levels, defined. Every Core claim links to the work that proves it. No percentages, because a "90% Playwright" bar encodes nothing you can check.
outline: true
---
<div class="level-key">
    <dl>
        {% for id, level in skills.levels %}
        <div class="level-key__item">
            <dt>{{ level.label }}</dt>
            <dd>{{ level.definition }}</dd>
        </div>
        {% endfor %}
    </dl>
</div>

{% for group in skills.groups %}
<section class="capability__group" aria-labelledby="group-{{ group.id }}">
    <h2 id="group-{{ group.id }}">{{ group.name }}</h2>
    {% if group.lede %}<p>{{ group.lede }}</p>{% endif %}

    {% for levelId, level in skills.levels %}
        {% set matching = group.skills | byLevel(levelId) %}
        {% if matching.length %}
        <div class="capability__level" data-level="{{ levelId }}">
            <h3 class="capability__level-title">{{ level.label }}</h3>
            <ul class="capability__list">
                {% for skill in matching %}
                <li class="capability__item">
                    <span class="capability__name">{{ skill.name }}</span>
                    {% if skill.note %}<span class="capability__note">{{ skill.note }}</span>{% endif %}
                    {% if skill.evidence %}<a class="capability__evidence" href="{{ skill.evidence | url }}">Evidence</a>{% endif %}
                </li>
                {% endfor %}
            </ul>
        </div>
        {% endif %}
    {% endfor %}
</section>
{% endfor %}

{#
  Twelve repositories were twelve bare paragraphs, each capped at the reading
  measure by base.css, stacked down a 1100px column. A repository is a record —
  name, what it does, language, licence — not a paragraph, so it gets the card
  grid the rest of the site uses for records.
#}
<h2>Open source</h2>
<ul class="card-list card-list--three">
    {% for project in skills.openSource %}
    <li class="card card--plain">
        <h3 class="card__title"><a href="{{ project.url }}" rel="noopener">{{ project.name }}</a></h3>
        <p class="card__body">{{ project.description }}</p>
        <p class="card__meta">
            {{ project.language }}{% if project.license %} · {{ project.license }}{% endif %}{% if project.metric %} · {% metric project.metric %}{% endif %}
        </p>
    </li>
    {% endfor %}
</ul>
