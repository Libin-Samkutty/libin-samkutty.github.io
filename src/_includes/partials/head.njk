{#
  The <head> contract. Every page gets its title, description and canonical from
  here, so "Page | Libin Samkutty" and a unique 140-158 character description are
  structural properties rather than things thirteen files each have to get right.
#}
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">

{# Declared before the stylesheet so the UA paints the correct ground colour on
   the very first frame, not after CSS resolves. #}
<meta name="color-scheme" content="light dark">

<title>{{ (shortTitle or title) }}{{ site.titleSuffix }}</title>

{% if description %}
<meta name="description" content="{{ description }}">
{% endif %}

<link rel="canonical" href="{{ (canonical or page.url) | absoluteUrl }}">

{# Media-scoped so the browser chrome is right with JavaScript off. The `media`
   attribute is also the problem: both tags track the OS, so once a reader uses
   the toggle the chrome disagrees with the page. The script below re-points
   `media` at `all` / `not all` when an explicit theme is in force, which is why
   each tag carries a `data-theme-color` hook. #}
<meta name="theme-color" content="{{ site.themeColor.light }}" media="(prefers-color-scheme: light)" data-theme-color="light">
<meta name="theme-color" content="{{ site.themeColor.dark }}" media="(prefers-color-scheme: dark)" data-theme-color="dark">

{# Open Graph and Twitter. Third person here — first person belongs in body copy,
   not in a card rendered next to someone else's link. #}
<meta property="og:type" content="{{ ogType or 'website' }}">
<meta property="og:title" content="{{ (shortTitle or title) }}{{ site.titleSuffix }}">
{% if description %}<meta property="og:description" content="{{ description }}">{% endif %}
<meta property="og:url" content="{{ page.url | absoluteUrl }}">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:locale" content="en_GB">
{# The card path is a convention, not a file the author has to remember to make:
   `scripts/og-images.mjs` reads this declaration back out of the built HTML and
   renders to exactly the path named here. `tests/links.spec.js` then asserts the
   file exists, because the previous version of this line pointed at an asset in
   an unpublished directory and every social card on the site was a 404. #}
<meta property="og:image" content="{{ ('/og/' + (page.url | ogSlug) + '.png') | absoluteUrl }}">
<meta name="twitter:card" content="summary_large_image">

{% if noindex %}<meta name="robots" content="noindex, follow">{% endif %}

{# Only the two above-the-fold faces: Sans carries the hero heading and every
   other page's <h1>, Serif carries the hero lede and all body prose. Mono's
   eyebrow line is small enough to arrive on its own without a preload. #}
<link rel="preload" href="{{ '/assets/fonts/ibm-plex-sans-var.woff2' | url }}" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="{{ '/assets/fonts/ibm-plex-serif-400.woff2' | url }}" as="font" type="font/woff2" crossorigin>

<link rel="stylesheet" href="{{ '/css/main.css' | url }}">

{# The PNG is the fallback for browsers without SVG favicon support, declared
   second so anything modern takes the vector. It shipped to /assets/ for months
   referenced by nothing at all, which is the same defect as a broken link. #}
<link rel="icon" href="{{ '/assets/favicon.svg' | url }}" type="image/svg+xml">
<link rel="icon" href="{{ '/assets/icon.png' | url }}" sizes="16x16" type="image/png">
<link rel="alternate" type="application/atom+xml" title="{{ site.name }}" href="{{ '/feed.xml' | url }}">

{# Two lines, synchronous, above the fold. The first resolves the theme before
   first style resolution so a dark-mode reader never sees a white flash. The
   second is the gate for every scroll reveal on the site: with JavaScript off,
   `.js` is never added, no reveal rule matches, and all content is visible.
   Motion is opt-in, not something the reader has to survive. #}
<script>
    (function () {
        var root = document.documentElement;
        root.classList.add("js");
        try {
            var stored = localStorage.getItem("theme");
            if (stored === "light" || stored === "dark") {
                root.dataset.theme = stored;
                // The chrome colour has to move with the page on this same first
                // frame. Duplicated in site.js rather than shared, because an
                // inline bootstrap cannot import from a module — and a global
                // just to save four lines is a worse trade.
                document.querySelectorAll("meta[data-theme-color]").forEach(function (meta) {
                    meta.media = meta.dataset.themeColor === stored ? "all" : "not all";
                });
            }
        } catch (e) {}
    })();
</script>
