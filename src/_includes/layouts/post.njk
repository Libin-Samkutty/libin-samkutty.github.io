---
layout: layouts/base.njk
ogType: article
eleventyComputed:
  # Computed rather than set in the template body: Eleventy's layout chain renders
  # child before parent, so a {% set %} here would never reach the <head>.
  articleType: "{% if technical %}TechArticle{% else %}Article{% endif %}"
  datePublished: "{{ date | isoDate }}"
---
<article class="post">
    <header class="post__header">
        <div class="wrap">
            <p class="post__eyebrow">
                <time datetime="{{ date | isoDate }}">{{ date | readableDate }}</time>
                <span class="post__reading-time" data-volatile>{{ content | readingTime }} min read</span>
            </p>
            <h1 class="post__title">{{ title }}</h1>
        </div>
    </header>

    {#
      The document grid, two tracks: rail and content.

      An aside holding the post's tags was the first version and it lost more
      than it gained. Reserving the third track took the content column from
      1104px to 800, which changed nothing for prose — that is capped at 51ch in
      base.css either way — but made every table in a post taller. One post came
      out 119px longer than before the refit, to display four tags. They are
      back in the footer, where a tag list reads as a coda rather than as
      something you need before the article.
    #}
    <div class="wrap doc">
        <div class="doc__rail" data-outline></div>

        <div class="post__body doc__main">
            <!--outline:start-->
            {{ content | safe }}
            <!--outline:end-->
        </div>
    </div>

    <footer class="post__footer wrap">
        {% if tags.length %}
        <ul class="chips chips--tags">
            {% for tag in tags %}<li class="chip">{{ tag }}</li>{% endfor %}
        </ul>
        {% endif %}

        {% set related = collections.posts | otherThan(page.url) | limit(3) %}
        {% if related.length %}
        <nav class="related" aria-label="More writing">
            <h2 class="related__title">More writing</h2>
            <ul class="related__list">
                {% for item in related %}
                <li><a href="{{ item.url }}">{{ item.data.title }}</a></li>
                {% endfor %}
            </ul>
        </nav>
        {% endif %}
    </footer>
</article>
