---
layout: layouts/base.njk
articleType: TechArticle
ogType: article
---
<article class="case-study">
    <header class="case-study__header">
        <div class="wrap">
            <p class="case-study__eyebrow">
                <span class="case-study__number">Case study {{ number }}</span>
                <span class="case-study__period">{{ period }}</span>
            </p>
            <h1 class="case-study__title">{{ title }}</h1>
            {% if outcome %}<p class="case-study__outcome">{{ outcome }}</p>{% endif %}
        </div>
    </header>

    {#
      The document grid: section rail, prose, context strip.

      Source order is rail, context strip, prose — which is exactly the order a
      phone renders them in, and the order anyone reading linearly gets. The
      rail is one scrolling line at that width, not ten stacked links, so it
      costs a reader about 44px before the attribution they actually need.

      At 64em CSS moves the strip to the right of the prose. It keeps its place
      in the reading order and stops costing vertical space, which is the whole
      trade.
    #}
    <div class="wrap doc doc--aside">
        <div class="doc__rail" data-outline></div>

        {#
          "What was mine / what wasn't" sits with the article, not in a footnote
          at the bottom, because a reader who stops after the first screen should
          still leave with an accurate picture of the attribution.
        #}
        <div class="doc__aside">
            <dl class="context-strip">
                <div class="context-strip__row">
                    <dt>Role at the time</dt>
                    <dd>{{ roleAtTime }}</dd>
                </div>
                <div class="context-strip__row">
                    <dt>Scope</dt>
                    <dd>{{ scope }}</dd>
                </div>
                <div class="context-strip__row">
                    <dt>Stack</dt>
                    <dd>
                        <ul class="chips">
                            {% for item in stack %}<li class="chip">{{ item }}</li>{% endfor %}
                        </ul>
                    </dd>
                </div>
                <div class="context-strip__row">
                    <dt>What was mine</dt>
                    <dd>{{ mine }}</dd>
                </div>
                {% if notMine %}
                <div class="context-strip__row context-strip__row--attribution">
                    <dt>What wasn't</dt>
                    <dd>{{ notMine }}</dd>
                </div>
                {% endif %}
                {% if demos %}
                <div class="context-strip__row">
                    <dt>Public demos</dt>
                    <dd>
                        <ul class="chips">
                            {% for demo in demos %}<li><a class="chip chip--link" href="{{ demo.url }}" rel="noopener">{{ demo.name }}</a></li>{% endfor %}
                        </ul>
                    </dd>
                </div>
                {% endif %}
            </dl>
        </div>

        <div class="case-study__body doc__main">
            <!--outline:start-->
            {{ content | safe }}
            <!--outline:end-->
        </div>
    </div>

    <footer class="case-study__footer wrap">
        <p class="case-study__reviewed">
            Written {{ datePublished | readableDate }}.
            {% if lastReviewed and lastReviewed != datePublished %}Last reviewed {{ lastReviewed | readableDate }}.{% endif %}
            Numbers on this page come from a single data file with recorded provenance;
            where a figure is approximate or projected, it says so.
        </p>

        {% set related = collections.caseStudies | otherThan(page.url) | limit(2) %}
        {% if related.length %}
        <nav class="related" aria-label="Related case studies">
            <h2 class="related__title">Related work</h2>
            <ul class="related__list">
                {% for item in related %}
                <li><a href="{{ item.url }}">{{ item.data.title }}</a></li>
                {% endfor %}
            </ul>
        </nav>
        {% endif %}

        <div class="case-study__cta">
            <p>If this is the kind of problem you need solved, let's talk.</p>
            <p class="button-row">
                <a class="button button--primary" href="mailto:{{ site.email }}">Email me</a>
                <a class="button button--ghost" href="{{ '/resume/' | url }}">Résumé</a>
            </p>
        </div>
    </footer>
</article>
